{
  "name": "blazzing-windows",
  "version": "1.4.7",
  "private": true,
  "description": "Blazzing desktop port for Windows",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "pack": "npm run prepare-app && electron-builder --dir --win --x64",
    "dist": "npm run prepare-app && electron-builder --win nsis portable --x64",
    "test": "node tests/prepare-app.test.js"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.xoykor.Blazzing",
    "productName": "Blazzing",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "js/**/*",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/tizen/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Blazzing-${version}-Windows-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Blazzing-${version}-Windows-${arch}-Portable.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
