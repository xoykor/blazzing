pkgname=blazzing
pkgver=1.2.7
pkgrel=1
pkgdesc='Fast visual IPTV client for Linux/X11'
arch=('x86_64')
url='https://github.com/xoykor/blazzing'
license=('MIT')
depends=(
  'curl'
  'ffmpeg'
  'glibc'
  'json-c'
  'libjpeg-turbo'
  'libpng'
  'libwebp'
  'libx11'
  'mpv'
  'openssl'
  'sqlite'
)
makedepends=(
  'cmake'
  'gcc'
  'make'
  'pkgconf'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "${srcdir}/blazzing-${pkgver}" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build --parallel
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${srcdir}/blazzing-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
